# Copy to .env.local for local development only. Never commit real values.

REFERRAL_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
ADMIN_SESSION_SECRET="replace-with-a-high-entropy-admin-session-secret"
PATIENT_SESSION_SECRET="replace-with-a-high-entropy-patient-session-secret"
PH7_WEBHOOK_SECRET="replace-with-a-webhook-signing-secret"

# Explicit staging/demo controls. Do not enable by accident in production.
APP_ENV="preview"
REFERRAL_DEMO_MODE="false"

# Future pH7 signed hand-off contract. Leave unset until pH7 provides values.
PH7_HANDOFF_JWKS_URL=""
PH7_HANDOFF_ISSUER=""
PH7_HANDOFF_AUDIENCE=""
PH7_HANDOFF_ALLOWED_ALGORITHMS=""
PH7_HANDOFF_MAX_TTL_SECONDS=""
