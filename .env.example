# Copy to .env.local for local development only. Never commit real values.
# Founder-only password verifier; versioned salted scrypt credential JSON, server-only.
ADMIN_LOGIN_CREDENTIAL=
# Server-only secure payout storage: 32-byte key as 64 hex characters or canonical base64.
# Leave empty to keep online withdrawals unavailable. Never expose or rotate casually.
PAYOUT_DATA_ENCRYPTION_KEY=

REFERRAL_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
ADMIN_SESSION_SECRET="replace-with-a-high-entropy-admin-session-secret"
PATIENT_SESSION_SECRET="replace-with-a-high-entropy-patient-session-secret"
PH7_WEBHOOK_SECRET="replace-with-a-webhook-signing-secret"
PH7_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS="300"

# Explicit staging/demo controls. Do not enable by accident in production.
APP_ENV="preview"
REFERRAL_DEMO_MODE="false"

# Confirmed pH7 signed hand-off contract. Fill with the approved non-secret values documented in PH7_INTEGRATION.md.
PH7_HANDOFF_JWKS_URL="https://approved-jwks-url.example"
PH7_HANDOFF_ISSUER="https://approved-issuer.example"
PH7_HANDOFF_AUDIENCE="approved-audience"
PH7_HANDOFF_ALLOWED_ALGORITHMS="ES256"
PH7_HANDOFF_MAX_TTL_SECONDS="300"

# Confirmed referral boundary. REFERRAL_PUBLIC_URL is optional on Vercel because VERCEL_URL is used automatically.
PH7_PATIENTS_URL="https://approved-patient-destination.example"
REFERRAL_PUBLIC_URL=""
